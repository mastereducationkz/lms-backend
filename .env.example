POSTGRES_PASSWORD=
POSTGRES_URL=

# CRM internal (optional): same value as CRM LMS_INTERNAL_SERVICE_KEY — GET /internal/crm/health
# CRM_INTERNAL_SERVICE_KEY=

# Support platform, INBOUND (optional): read-only student context for the Support
# platform's AI agent — GET /support-api/users/{email},
# GET /support-api/students/{email}/context. This is the key SUPPORT presents to US.
SUPPORT_API_KEY=

# Support platform, OUTBOUND (optional): the Telegram announcements screen
# (/admin/announcements) proxies through us to Support's /service-api, which owns
# the bot, the group registry and the delivery queue.
#
# SUPPORT_SERVICE_API_KEY is a DIFFERENT secret from SUPPORT_API_KEY above and
# must equal `SERVICE_API_KEY` in the Support platform's prod .env. Do not reuse
# the inbound key here — that would hand our own inbound credential to an
# outbound caller. Unset ⇒ the announcements screen returns 503.
SUPPORT_API_BASE=https://supportapi.mastereducation.kz
SUPPORT_SERVICE_API_KEY=

# --- SSO Phase 0 (teacher-login handoff broker; OFF by default = legacy path) ---
# When enabled, POST /internal/crm/issue-teacher-handoff verifies a teacher's LMS
# credential and mints a broker handoff for CRM (replaces CRM reading LMS hashes).
# SSO_BROKER_ENABLED=false
# SSO_BROKER_URL=https://auth.mastereducation.kz
# SSO_BROKER_MINT_KEY=            # == broker BROKER_MINT_SERVICE_KEYS
# SSO_TEACHER_ROLES=teacher,head_teacher
# SSO_TEACHER_PASSWORD_ALGORITHM=auto   # auto|bcrypt|django_pbkdf2_sha256|plain


# JWT signing secret - REQUIRED for production. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# --- SSO Phase 2 (accept central-IdP OIDC tokens alongside legacy HS256; OFF by default) ---
# When enabled, LMS also accepts RS256 tokens from Zitadel, validated via JWKS, and maps
# them to an existing LMS user by the email claim. Legacy HS256 tokens keep working.
# NOTE: the Zitadel client apps' access-token type must be JWT (not opaque) for JWKS
# validation to work, and tokens must carry an `email` claim.
# OIDC_ACCEPT=false
# OIDC_ISSUERS=https://mastereducation-fvbwjk.eu1.zitadel.cloud
# OIDC_JWKS_URL=https://mastereducation-fvbwjk.eu1.zitadel.cloud/oauth/v2/keys
# lms-api, lms-web, lms-mobile resource/client IDs (aud matches if it contains ANY):
# OIDC_AUDIENCE=381059919115311667,381061947262549203,381062426705116371
# Zitadel access tokens don't carry email — LMS resolves it from userinfo:
# OIDC_USERINFO_URL=https://mastereducation-fvbwjk.eu1.zitadel.cloud/oidc/v1/userinfo
# OIDC_LEEWAY_SECONDS=60
# Only trust an IdP email as a user-match key if it's marked verified (default true).
# Prevents an unverified-email IdP account from resolving to / hijacking a victim by email.
# Break-glass: set to false to accept unverified emails (not recommended).
# OIDC_REQUIRE_EMAIL_VERIFIED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Environment (development or production)
# Set to "production" for HTTPS with secure cookies
ENVIRONMENT=development

# RabbitMQ Configuration (Central Auth System)
# Format: amqp://username:password@host:port/
RABBITMQ_URL=amqp://auth:YOUR_RABBITMQ_PASSWORD@localhost:5672/
RABBITMQ_EXCHANGE=user_events

# SAT platform API (api.mastereducation.kz) — leaderboard mock-exam scores
MASTEREDU_API_KEY=

# IELTS platform API (ieltsapi.mastereducation.kz) — weekly band scores + examiner feedback
IELTS_API_KEY=

# Resend API for Email Notifications
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_SENDER=noreply@mail.mastereducation.kz
EMAIL_SENDER_NAME=LMS | Master Education
LMS_URL=https://lms.mastereducation.kz/homework

# Lesson reminder emails: production uses docker-compose service "scheduler" (run_scheduler).
# Set true only for local API without the scheduler container (use uvicorn --workers 1).
ENABLE_LESSON_REMINDER_IN_API=false

# Public Telegram channel for webinar/office-hours announcements. The value is the Support
# registry id from /admin/announcements, not Telegram's -100... chat id.
# ENABLE_TELEGRAM_EVENT_ANNOUNCEMENTS=false
# TELEGRAM_EVENT_ANNOUNCEMENT_GROUP_ID=

# DISABLE_SCHEDULER=true disables curator background tasks in the API only, not lesson reminders

# The daily fines post to «Штрафы учителя» (src/discipline/digest.py), a forum topic in the
# staff supergroup «Кураторы Master Education». Off unless the flag is on AND a chat is
# configured — a fines channel that posts into the wrong room is worse than one that is silent.
# The topic id is the number in its t.me/c/<chat>/<topic> link. The support group defaults to
# MEET_NOTICES_SUPPORT_GROUP_ID, since the Meet staff notices post into the same supergroup;
# set DISCIPLINE_NOTICES_SUPPORT_GROUP_ID only if that stops being true.
ENABLE_DISCIPLINE_DIGEST=false
DISCIPLINE_NOTICES_TOPIC_ID=9347
# DISCIPLINE_NOTICES_SUPPORT_GROUP_ID=
