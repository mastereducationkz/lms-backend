POSTGRES_PASSWORD=
POSTGRES_URL=

# CRM internal (optional): same value as CRM LMS_INTERNAL_SERVICE_KEY — GET /internal/crm/health
# CRM_INTERNAL_SERVICE_KEY=

# --- SSO Phase 0 (teacher-login handoff broker; OFF by default = legacy path) ---
# When enabled, POST /internal/crm/issue-teacher-handoff verifies a teacher's LMS
# credential and mints a broker handoff for CRM (replaces CRM reading LMS hashes).
# SSO_BROKER_ENABLED=false
# SSO_BROKER_URL=https://auth.mastereducation.kz
# SSO_BROKER_MINT_KEY=            # == broker BROKER_MINT_SERVICE_KEYS
# SSO_TEACHER_ROLES=teacher,head_teacher
# SSO_TEACHER_PASSWORD_ALGORITHM=auto   # auto|bcrypt|django_pbkdf2_sha256|plain


# JWT signing secret - REQUIRED for production. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Environment (development or production)
# Set to "production" for HTTPS with secure cookies
ENVIRONMENT=development

# RabbitMQ Configuration (Central Auth System)
# Format: amqp://username:password@host:port/
RABBITMQ_URL=amqp://auth:YOUR_RABBITMQ_PASSWORD@localhost:5672/
RABBITMQ_EXCHANGE=user_events

# SAT platform API (api.mastereducation.kz) — leaderboard mock-exam scores
MASTEREDU_API_KEY=

# IELTS platform API (ieltsapi.mastereducation.kz) — weekly band scores + examiner feedback
IELTS_API_KEY=

# Resend API for Email Notifications
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_SENDER=noreply@mail.mastereducation.kz
EMAIL_SENDER_NAME=MasterED Platform
LMS_URL=https://lms.mastereducation.kz/homework

# Lesson reminder emails: production uses docker-compose service "scheduler" (run_scheduler).
# Set true only for local API without the scheduler container (use uvicorn --workers 1).
ENABLE_LESSON_REMINDER_IN_API=false

# DISABLE_SCHEDULER=true disables curator background tasks in the API only, not lesson reminders
